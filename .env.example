STYLECAPTURE_DATABASE_URL=postgresql+asyncpg://stylecapture:stylecapture@postgres:5432/stylecapture
STYLECAPTURE_REDIS_URL=redis://redis:6379/0
STYLECAPTURE_UPLOAD_ROOT=/data/uploads
STYLECAPTURE_UPLOAD_SIGNING_SECRET=replace-with-at-least-24-random-characters
STYLECAPTURE_SESSION_SIGNING_SECRET=replace-with-a-distinct-session-signing-secret
STYLECAPTURE_SESSION_COOKIE_SECURE=false
STYLECAPTURE_CORS_ORIGINS=["http://localhost:5173"]
STYLECAPTURE_VISION_MODEL_ALIAS=vision_understanding
STYLECAPTURE_LITELLM_BASE_URL=http://litellm:4000/v1
STYLECAPTURE_LITELLM_API_KEY=replace-with-an-internal-gateway-secret
STYLECAPTURE_EMBEDDING_MODE=disabled
STYLECAPTURE_EMBEDDING_DEVICE=cpu
# For real SAM2 refinement set these to true/sam2 and raise the worker limit to 2G.
STYLECAPTURE_INSTALL_AI_LIGHT=false
STYLECAPTURE_SEGMENTATION_MODE=coarse
STYLECAPTURE_SEGMENTATION_DEVICE=cpu
STYLECAPTURE_SEGMENTATION_SCORE_THRESHOLD=0.7
STYLECAPTURE_WORKER_MEMORY_LIMIT=1G
STYLECAPTURE_CAPTURE_QUEUE=capture
LITELLM_MASTER_KEY=replace-with-an-internal-gateway-secret
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_VISION_MODEL=doubao-seed-2-0-lite-260428
