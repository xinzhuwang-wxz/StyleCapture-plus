# Public HTTPS host. Issue #6 uses a trusted short-lived Let's Encrypt IP certificate.
STYLECAPTURE_PUBLIC_HOST=119.45.216.38
STYLECAPTURE_LETSENCRYPT_DIR=/srv/stylecapture/shared/letsencrypt
STYLECAPTURE_TLS_CERT_FILE=/etc/letsencrypt/live/119.45.216.38/fullchain.pem
STYLECAPTURE_TLS_KEY_FILE=/etc/letsencrypt/live/119.45.216.38/privkey.pem

# Generate unique values for every deployment. Never commit the real file.
POSTGRES_PASSWORD=replace-with-a-random-hex-value
LITELLM_MASTER_KEY=sk-replace-with-a-random-value
STYLECAPTURE_UPLOAD_SIGNING_SECRET=replace-with-at-least-24-random-characters
STYLECAPTURE_SESSION_SIGNING_SECRET=replace-with-a-distinct-session-signing-secret

# Server-only hosted model credentials.
ARK_API_KEY=replace-with-ark-api-key
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
FASHN_API_KEY=

# Laptop/server-safe defaults. AI-heavy is never enabled by this file.
STYLECAPTURE_AI_THREAD_LIMIT=1
STYLECAPTURE_WORKER_CONCURRENCY=2
STYLECAPTURE_CAPTURE_QUEUE=capture
STYLECAPTURE_RENDER_QUEUE=render
STYLECAPTURE_EMBEDDING_MODE=hosted
STYLECAPTURE_EMBEDDING_MODEL=doubao-embedding-vision-250615

# Optional build mirrors for the Tencent Cloud host. Product runtime behavior is
# independent of these package download endpoints.
UV_DEFAULT_INDEX=https://mirrors.cloud.tencent.com/pypi/simple
UV_LOCK_MIRROR_BASE=https://mirrors.cloud.tencent.com/pypi
UV_INSECURE_HOST=
NPM_CONFIG_REGISTRY=https://registry.npmmirror.com
