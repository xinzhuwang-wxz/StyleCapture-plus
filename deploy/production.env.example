# Public HTTPS host. An sslip.io host is sufficient for the judging deployment.
STYLECAPTURE_PUBLIC_HOST=119-45-216-38.sslip.io

# Generate unique values for every deployment. Never commit the real file.
POSTGRES_PASSWORD=replace-with-a-random-hex-value
LITELLM_MASTER_KEY=sk-replace-with-a-random-value
STYLECAPTURE_UPLOAD_SIGNING_SECRET=replace-with-at-least-24-random-characters
STYLECAPTURE_SESSION_SIGNING_SECRET=replace-with-a-distinct-session-signing-secret

# Server-only hosted model credentials.
ARK_API_KEY=replace-with-ark-api-key
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
FASHN_API_KEY=

# Laptop/server-safe defaults. AI-heavy is never enabled by this file.
STYLECAPTURE_AI_THREAD_LIMIT=1
STYLECAPTURE_CAPTURE_QUEUE=capture
STYLECAPTURE_RENDER_QUEUE=render
STYLECAPTURE_EMBEDDING_MODE=hosted
STYLECAPTURE_EMBEDDING_MODEL=doubao-embedding-vision-250615
