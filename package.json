{
  "name": "stylecapture-plus",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "contracts:generate": "pnpm --filter @stylecapture/h5 generate:api",
    "lint": "pnpm -r --if-present lint",
    "playground:scene-outfit": "node skills/scene-outfit-matching/scripts/match.js --request '{\"scene\":\"通勤面试\",\"formality\":\"正式商务\",\"comfort\":\"久坐舒适\"}'",
    "test": "pnpm -r --if-present test && pnpm test:scene-outfit",
    "test:scene-outfit": "node --test skills/scene-outfit-matching/tests/*.test.js",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": "^5.0.8",
      "js-yaml": "^4.3.0"
    }
  }
}
